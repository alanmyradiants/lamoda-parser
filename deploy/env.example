# База: пусто -> SQLite data/lamoda.db; для Supabase — строка подключения (Settings -> Database -> URI)
DATABASE_URL=
# Российский резидентный/мобильный прокси: http://user:pass@host:port
# Обязателен: IP Timeweb Lamoda блокирует («Запрос отклонен»), проверено 23.09.2026
LAMODA_PROXY=
# Карточки через настоящий браузер: Lamoda закрыта JS-проверкой Servicepipe, без браузера — 403
LAMODA_BROWSER=1
# Алерты о сбоях
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Метка запуска, глубина каталога, повтор артикулов из базы за N дней
LAMODA_SCOPE=men_clothes
LAMODA_PAGES=10
LAMODA_KNOWN_DAYS=14
LAMODA_HEADFUL=0
