# База: пусто -> SQLite data/lamoda.db; для Supabase — строка подключения (Settings -> Database -> URI)
DATABASE_URL=
# Российский прокси, если IP VPS не пускают: http://user:pass@host:port
LAMODA_PROXY=
# Алерты о сбоях
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Метка запуска, глубина каталога, повтор артикулов из базы за N дней
LAMODA_SCOPE=men_clothes
LAMODA_PAGES=10
LAMODA_KNOWN_DAYS=14
LAMODA_HEADFUL=0
